# Copy to .env (repo: jams/.env). Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://jams:jams@localhost:5432/jams
# Used by integration and e2e tests (tables are truncated!)
TEST_DATABASE_URL=postgres://jams:jams@localhost:5432/jams_test
APP_ORIGIN=http://localhost:5173
SESSION_TTL_DAYS=14
# Local object storage for resumes/documents/import files (outside the web root)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=15
# Set to false after creating your account to disable the first-run setup endpoint entirely
ALLOW_REGISTRATION=true
# Optional: enables AI job-description summaries and AI resume comparison (server-side only)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Seed account (fictional demo data)
SEED_EMAIL=demo@example.com
SEED_PASSWORD=demo-password-123
